generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReceiptStatus {
  UPLOADED
  PROCESSING
  REVIEW
  COMPLETED
  ERROR
}

enum ValidationStatus {
  CONSISTENT
  REVIEW
  INCONSISTENT
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts Receipt[]
}

model Receipt {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  /// Path privado del objeto dentro del bucket "receipts" de Supabase Storage
  /// (formato `<userId>/<uuid>.<ext>`). NO es una URL pública ni una signed URL.
  imageUrl           String
  status             ReceiptStatus @default(UPLOADED)
  /// Se incrementa cada vez que un procesamiento comienza (UPLOADED|ERROR → PROCESSING).
  processingAttempts Int           @default(0)
  /// Último error de procesamiento (se completa al pasar PROCESSING → ERROR).
  lastError          String?
  /// Hash SHA-256 de la imagen, para detectar comprobantes duplicados.
  imageHash          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ocrData     OcrData?
  corrections Correction[]
  validations Validation[]

  @@index([userId])
}

model OcrData {
  id              String    @id @default(uuid()) @db.Uuid
  receiptId       String    @unique @db.Uuid
  amount          Decimal?  @db.Decimal(12, 2)
  date            DateTime?
  operationNumber String?
  /// Banco o billetera que emitió el comprobante (logo o encabezado).
  issuer          String?
  senderName      String?
  /// CBU/CVU de quien envía (solo dígitos).
  senderCbuCvu    String?
  /// Banco o billetera de quien envía, si aparece explícitamente.
  senderBank      String?
  receiverName    String?
  /// CBU/CVU de quien recibe (solo dígitos).
  receiverCbuCvu  String?
  /// Banco o billetera de quien recibe, si aparece explícitamente.
  receiverBank    String?
  rawText         String?
  confidence      Decimal?  @db.Decimal(5, 4)
  /// Proveedor que extrajo los datos (ej. "gemini").
  provider        String?
  /// Modelo exacto usado para la extracción.
  model           String?
  /// Respuesta cruda del proveedor, para auditoría y debugging.
  rawResponse     Json?
  /// Resultado de las validaciones deterministas por campo.
  fieldChecks     Json?

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model Correction {
  id             String   @id @default(uuid()) @db.Uuid
  receiptId      String   @db.Uuid
  field          String
  originalValue  String
  correctedValue String
  createdAt      DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model Validation {
  id        String           @id @default(uuid()) @db.Uuid
  receiptId String           @db.Uuid
  status    ValidationStatus
  riskScore Int
  checks    Json
  createdAt DateTime         @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}
