# Copiá este archivo a .env y completá los valores.
# Todas las variables se validan al usarse (lib/env.ts): si falta una
# obligatoria, la app falla con un mensaje claro indicando cuál.

# ─── Base de datos ──────────────────────────────────────────────────────
# Local: docker-compose expone PostgreSQL en el puerto 5434.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/comprobante?schema=public"

# ─── Supabase Storage ───────────────────────────────────────────────────
# Project Settings → API. La secret key solo se usa en el servidor.
# Obligatorias solo si ALLOW_REAL_UPLOADS es true.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<supabase-secret-key>"

# ─── Upload de comprobantes reales ──────────────────────────────────────
# true | false. Sin definir: habilitado en desarrollo, deshabilitado en
# producción (modo demo, que no procesa comprobantes reales).
# ALLOW_REAL_UPLOADS=true

# ─── Extracción de datos (OCR / IA) ─────────────────────────────────────
# mock:   datos fijos, sin llamadas externas (default; dev y tests)
# gemini: Google Gemini. Requiere GEMINI_API_KEY.
#         ⚠️ Con una key del free tier, Google puede usar el contenido
#         enviado para mejorar sus productos: no usarla con comprobantes reales.
EXTRACTOR=mock
GEMINI_API_KEY=
# Opcional. Default: gemini-3.8-flash
GEMINI_MODEL=

# ─── Logs ───────────────────────────────────────────────────────────────
# debug | info | warn | error. Default: info
LOG_LEVEL=info
