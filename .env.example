# PostgreSQL local (docker-compose expone el contenedor en el puerto 5434)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/comprobante?schema=public"

# Supabase Storage (Project Settings → API). La secret key solo se usa en el servidor.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<supabase-secret-key>"
